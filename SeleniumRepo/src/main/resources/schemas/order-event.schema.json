{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderEvent",
  "description": "Contract for messages on order topics. Mirrors com.masterclass.kafka.model.OrderEvent.",
  "type": "object",
  "required": ["orderId", "customerId", "amount", "currency", "status", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^ORD-[0-9]{4,}$"
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "status": {
      "type": "string",
      "enum": ["CREATED", "PAID", "SHIPPED", "CANCELLED"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
